#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
export PATH="$ROOT/bin:$PATH"
export BINETIC_MAIN_INTERFACE="binetic-agent-tui"
if [ "${1:-}" = "--version" ] || [ "${1:-}" = "version" ]; then
  echo "Binetic Agent — Creator Edition"
  echo "build: private-creator"
  exit 0
fi
exec gnosh --cwd "$ROOT/runtime/binetic-superagent" \
  --append-system-prompt-file "$ROOT/runtime/binetic-superagent/BINETIC_SYSTEM_PROMPT.md" \
  "$@"
